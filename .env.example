APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# SECURITY: APP_DEBUG must be "false" in production. Leaving it "true" leaks
# stack traces (including server file paths) to anyone who triggers a 500.
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=*
APP_TIMEZONE=America/Sao_Paulo
APP_API_KEY=
PRINTER_SMB_USERNAME=
PRINTER_SMB_PASSWORD=
PRINTER_SMB_WORKGROUP=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
# Staff bearer tokens expire after this many minutes (720 = 12h, roughly a shift).
# A stolen/leaked token stops working on its own after this long.
SANCTUM_TOKEN_EXPIRATION_MINUTES=720

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Producao Debian + Apache (ajuste conforme seu dominio)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.exemplo.com.br
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.exemplo.com.br
# SANCTUM_STATEFUL_DOMAINS=api.exemplo.com.br,painel.exemplo.com.br
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=b_unilab
# DB_USERNAME=seu_usuario
# DB_PASSWORD=sua_senha

TICKET_PRINTER_ENABLED=false
TICKET_PRINTER_CONNECTION=network
TICKET_PRINTER_HOST=""
TICKET_PRINTER_PORT=
TICKET_PRINTER_SMB_URI=""
TICKET_PRINTER_CUPS_QUEUE=""
TICKET_PRINTER_PROFILE=simple
TICKET_PRINTER_HEADER="SENHA DE ATENDIMENTO"

VITE_APP_NAME="${APP_NAME}"
